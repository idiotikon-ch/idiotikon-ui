{
  "name": "@idiotikon/ui",
  "version": "0.1.0",
  "description": "A shared UI for Idiotikon applications - Vue 3 + Vuetify 4 components and configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./settings": "./src/settings.scss",
    "./styles": "./src/styles.scss"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:dry": "standard-version --dry-run"
  },
  "keywords": [
    "vue",
    "vuetify",
    "ui-components",
    "vue3",
    "idiotikon"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3",
    "vuetify": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "standard-version": "^9.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47"
  }
}
